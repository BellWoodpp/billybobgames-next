{
  "name": "my-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "outreach:import:resources": "python3 scripts/outreach/import-resources-xlsx.py",
    "outreach:score": "node scripts/outreach/score-prospects.cjs",
    "outreach:draft": "node scripts/outreach/draft-emails.cjs",
    "outreach:send-approved": "node scripts/outreach/send-approved.cjs",
    "outreach:verify-links": "node scripts/outreach/verify-links.cjs",
    "outreach:prepare": "python3 scripts/outreach/import-resources-xlsx.py && node scripts/outreach/score-prospects.cjs && node scripts/outreach/draft-emails.cjs",
    "outreach:gmail:auth-url": "node scripts/outreach/gmail-oauth.cjs auth-url",
    "outreach:gmail:listen": "node scripts/outreach/gmail-oauth.cjs listen",
    "outreach:gmail:exchange-code": "node scripts/outreach/gmail-oauth.cjs exchange-code",
    "outreach:gmail:test-profile": "node scripts/outreach/gmail-oauth.cjs test-profile",
    "outreach:gmail:send-test": "node scripts/outreach/gmail-oauth.cjs send-test",
    "upload:r2:games:dry": "node scripts/upload-r2.cjs --dir games --kind all --dry-run --no-map",
    "upload:r2:games": "node scripts/upload-r2.cjs --dir games --kind all",
    "upload:r2:sprunki:dry": "node scripts/upload-r2-sprunki-assets.cjs --dry-run",
    "upload:r2:sprunki": "node scripts/upload-r2-sprunki-assets.cjs",
    "prune:games:media:dry": "node scripts/prune-games-media.cjs --dry-run",
    "prune:games:media": "node scripts/prune-games-media.cjs --yes",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "@radix-ui/react-slot": "^1.2.4",
    "@unpic/react": "^1.0.2",
    "@vinext/cloudflare": "1.0.0-beta.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.562.0",
    "next": "16.0.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-server-dom-webpack": "^19.3.0",
    "tailwind-merge": "^3.4.0",
    "unpic": "^4.2.2",
    "vinext": "1.0.0-beta.10"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.955.0",
    "@cloudflare/vite-plugin": "^1.56.0",
    "@tailwindcss/postcss": "^4",
    "@turbowarp/packager": "3.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.35",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.0.10",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vite": "^8.3.0",
    "wrangler": "^4.135.0"
  },
  "type": "module"
}
